# Copy to .env on the server; change all default passwords/tokens before network exposure.
ENVIRONMENT=production
API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
CORS_ORIGINS=*

# Native API/worker processes connect to docker-published localhost ports.
DATABASE_URL=postgresql+psycopg://molplatform:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/molplatform
REDIS_URL=redis://127.0.0.1:6379/0
MOLPLATFORM_DATA_DIR=./data
MAX_UPLOAD_MB=2048
CHUNK_SIZE=5000
DOCKING_CHUNK_SIZE=250
MAX_WORKERS_PER_NODE=4

# Set to actual paths if executables aren't on PATH inside the WSL/Linux worker.
VINA_BINARY=vina
OBABEL_BINARY=obabel
GROMACS_BINARY=gmx
VINA_CPU_PER_LIGAND=1
GROMACS_MDRUN_THREADS=8
COMMAND_TIMEOUT_SECONDS=86400

# Optional OpenAI-compatible LLM API. The deterministic parser is used if these are blank.
# MoleCode structure conversion (SMILES ↔ Mermaid) does not call a model. If you use
# molecode.llm for optional graph editing, the app passes these same LLM_* values into
# molecode.LLMClient (base URL without a required /chat/completions suffix). Leave
# LLM_PROVIDER=none to skip that client. molecode.LLMClient can also read
# MOLECODE_API_KEY, MOLECODE_BASE_URL, and MOLECODE_MODEL when constructed directly.
# Never commit real keys.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# This is the same secret as POSTGRES_PASSWORD in docker compose.
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=molplatform
POSTGRES_USER=molplatform

# Optional Tamarind Bio cloud compute backend. Keep API key only in this server-side .env.
TAMARIND_API_BASE=https://app.tamarind.bio/api/
TAMARIND_API_KEY=
TAMARIND_REQUEST_TIMEOUT=120
TAMARIND_POLL_INTERVAL=15
TAMARIND_MAX_UPLOAD_MB=5120
TAMARIND_JOB_PREFIX=molplatform
